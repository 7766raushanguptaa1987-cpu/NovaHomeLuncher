<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.NovaHome" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/onui_accent</item>
        <item name="colorSurface">@color/onui_surface</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <style name="Theme.NovaHome.Home" parent="Theme.NovaHome">
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>
    <style name="Theme.NovaHome.Gaming" parent="Theme.NovaHome">
        <item name="colorPrimary">@color/gaming_accent</item>
        <item name="android:colorBackground">@color/gaming_bg</item>
    </style>
</resources>
