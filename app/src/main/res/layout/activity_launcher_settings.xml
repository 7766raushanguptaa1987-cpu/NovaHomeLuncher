<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FF121212">

    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingHorizontal="16dp">
        <ImageView android:id="@+id/settingsBack"
            android:layout_width="40dp" android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_revert"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/launcher_settings_title"
            android:textColor="#FFFFFFFF" android:textSize="18sp" android:textStyle="bold"/>
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingHorizontal="16dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Layout" android:textColor="#FF1A73E8" android:textSize="13sp"
                android:layout_marginTop="16dp" android:layout_marginBottom="8dp"/>

            <!-- Grid columns slider -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Home grid columns" android:textColor="#FFFFFFFF" android:textSize="15sp"/>
            <SeekBar android:id="@+id/gridColumnsSeek"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:max="2" android:progress="1"
                android:progressTint="#FF1A73E8" android:thumbTint="#FF1A73E8"
                android:layout_marginTop="8dp"/>
            <TextView android:id="@+id/gridColumnsLabel"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#99FFFFFF" android:textSize="13sp" android:text="4 columns"/>

            <!-- Dock size -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Dock icons" android:textColor="#FFFFFFFF" android:textSize="15sp"
                android:layout_marginTop="16dp"/>
            <SeekBar android:id="@+id/dockSizeSeek"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:max="2" android:progress="0"
                android:progressTint="#FF1A73E8" android:thumbTint="#FF1A73E8"
                android:layout_marginTop="8dp"/>
            <TextView android:id="@+id/dockSizeLabel"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#99FFFFFF" android:textSize="13sp" android:text="3 icons"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Apps" android:textColor="#FF1A73E8" android:textSize="13sp"
                android:layout_marginTop="24dp" android:layout_marginBottom="8dp"/>

            <LinearLayout android:id="@+id/goHideApps"
                android:layout_width="match_parent" android:layout_height="52dp"
                android:orientation="horizontal" android:gravity="center_vertical">
                <ImageView android:layout_width="24dp" android:layout_height="24dp"
                    android:src="@drawable/ic_hide" android:layout_marginEnd="16dp"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Hide apps" android:textColor="#FFFFFFFF" android:textSize="15sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="›" android:textColor="#66FFFFFF" android:textSize="20sp"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
