<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0121212">

    <!-- Search box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">
        <EditText
            android:id="@+id/searchBox"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_search_pill"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="8dp"
            android:paddingHorizontal="16dp"
            android:hint="@string/search_apps_hint"
            android:textColor="#FFFFFFFF"
            android:textColorHint="#99FFFFFF"
            android:singleLine="true"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:importantForAutofill="no" />
    </LinearLayout>

    <!-- Tab row: All / Games -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">
        <TextView
            android:id="@+id/tabAll"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="All apps"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tabGames"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Games"
            android:textColor="#66FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Divider -->
    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="#1FFFFFFF" android:layout_marginHorizontal="16dp" />

    <!-- App grid -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/drawerGrid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="24dp" />

</LinearLayout>
