<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet"
    android:paddingTop="12dp"
    android:paddingBottom="32dp">

    <!-- Handle indicator -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="20dp"
        android:background="#40FFFFFF" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingHorizontal="16dp">

        <!-- Wallpaper -->
        <LinearLayout android:id="@+id/btnWallpaper"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical"
            android:gravity="center" android:padding="12dp"
            android:background="@drawable/bg_edit_action">
            <ImageView android:layout_width="32dp" android:layout_height="32dp"
                android:src="@drawable/ic_wallpaper" android:scaleType="fitCenter"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/wallpaper" android:textColor="#FFFFFFFF"
                android:textSize="12sp" android:layout_marginTop="6dp"/>
        </LinearLayout>

        <View android:layout_width="8dp" android:layout_height="1dp"/>

        <!-- Widgets -->
        <LinearLayout android:id="@+id/btnWidgets"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical"
            android:gravity="center" android:padding="12dp"
            android:background="@drawable/bg_edit_action">
            <ImageView android:layout_width="32dp" android:layout_height="32dp"
                android:src="@drawable/ic_widgets" android:scaleType="fitCenter"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/widgets" android:textColor="#FFFFFFFF"
                android:textSize="12sp" android:layout_marginTop="6dp"/>
        </LinearLayout>

        <View android:layout_width="8dp" android:layout_height="1dp"/>

        <!-- Themes -->
        <LinearLayout android:id="@+id/btnThemes"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical"
            android:gravity="center" android:padding="12dp"
            android:background="@drawable/bg_edit_action">
            <ImageView android:layout_width="32dp" android:layout_height="32dp"
                android:src="@drawable/ic_themes" android:scaleType="fitCenter"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/themes" android:textColor="#FFFFFFFF"
                android:textSize="12sp" android:layout_marginTop="6dp"/>
        </LinearLayout>

        <View android:layout_width="8dp" android:layout_height="1dp"/>

        <!-- Settings -->
        <LinearLayout android:id="@+id/btnHomeSettings"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical"
            android:gravity="center" android:padding="12dp"
            android:background="@drawable/bg_edit_action">
            <ImageView android:layout_width="32dp" android:layout_height="32dp"
                android:src="@drawable/ic_settings" android:scaleType="fitCenter"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/home_settings" android:textColor="#FFFFFFFF"
                android:textSize="12sp" android:layout_marginTop="6dp"/>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
