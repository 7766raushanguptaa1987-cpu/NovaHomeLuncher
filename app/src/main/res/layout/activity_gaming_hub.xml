<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FF0A0A0A">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="52dp"
        android:paddingBottom="16dp">
        <ImageView android:id="@+id/gamingBack"
            android:layout_width="40dp" android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_revert"
            android:scaleType="fitCenter"/>
        <ImageView android:layout_width="32dp" android:layout_height="32dp"
            android:src="@drawable/ic_gaming" android:layout_marginStart="8dp"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Gaming Hub"
            android:textColor="#FF00BFA5"
            android:textSize="22sp" android:textStyle="bold"/>

        <!-- Game Mode toggle -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Game Mode"
            android:textColor="#99FFFFFF" android:textSize="12sp"
            android:layout_marginEnd="8dp"/>
        <Switch android:id="@+id/gameModeSwitch"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:thumbTint="#FF00BFA5" android:trackTint="#3300BFA5"/>
    </LinearLayout>

    <!-- Performance stats bar -->
    <LinearLayout
        android:id="@+id/statsBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#FF1A1A1A"
        android:paddingHorizontal="24dp">
        <TextView android:id="@+id/statFps"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="center"
            android:textColor="#FF00BFA5" android:textSize="13sp"
            android:text="FPS: Ready"/>
        <TextView android:id="@+id/statRam"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="center"
            android:textColor="#FF00BFA5" android:textSize="13sp"
            android:text="RAM: --"/>
        <TextView android:id="@+id/statNet"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="center"
            android:textColor="#FF00BFA5" android:textSize="13sp"
            android:text="Network: ON"/>
    </LinearLayout>

    <!-- Games grid -->
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Your Games"
        android:textColor="#FFFFFFFF" android:textSize="16sp" android:textStyle="bold"
        android:layout_marginStart="16dp" android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/gamesGrid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="12dp"/>

    <TextView android:id="@+id/noGamesText"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/no_games"
        android:textColor="#66FFFFFF"
        android:textSize="15sp"
        android:visibility="gone"/>
</LinearLayout>
